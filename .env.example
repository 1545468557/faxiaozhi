# ============================================================
# 法小智 · 本地配置模板（不含任何真实密钥，可以提交到仓库）
# 用法：复制本文件为 .env，填好标了【要填】的几行即可。
# .env 已被 .gitignore 排除，不会进仓库、不会进前端、不会进日志。
# 密钥只填在 .env 里 —— 不要贴在对话、截图或提交记录中。
# ============================================================

# ---- 模型（DeepSeek）----
# 留空也能启动：自动进入离线 stub 模式（用于自动化测试与断网降级）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-chat
# auto | stub | deepseek（注释必须单独成行：本项目不剥离行内注释，
# 写成 `MODEL_PROVIDER=stub  # 离线` 会让「强制 stub」静默失效）
MODEL_PROVIDER=auto

# ---- 北大法宝 MCP ----
# 有几个服务地址就填几个；不够可以接着加 PKULAW_MCP_URL_5=
# 地址里若已带密钥（?token=xxx），该地址本身即视为密钥，不要外发
PKULAW_MCP_URL_1=
PKULAW_MCP_URL_2=
PKULAW_MCP_URL_3=
PKULAW_MCP_URL_4=

# 所有地址共用一个鉴权 Key 时只填这一处；带不带 "Bearer " 前缀都行
PKULAW_MCP_TOKEN=

# ---- 本地服务 ----
APP_HOST=127.0.0.1
APP_PORT=8010

# ---- 账号与短信验证码 ----
# 登录方式：手机号 + 验证码（主）/ 密码（辅）；注册仍需邀请码。
# 短信通道：mock（默认，不真发，验证码写到日志与 data/sms-outbox.jsonl）| aliyun | tencent
#
# 注意：本项目的 .env 解析是「极简解析」，**不剥离行内注释** ——
# 写成 `KEY=300  # 说明` 会把「# 说明」也当成值（然后 int() 报错）。
# 所以注释一律**单独占一行**，不要写在值的后面。
SMS_PROVIDER=mock

# 验证码策略（一般不用改）
AUTH_CODE_LENGTH=6
# 有效期（秒）
AUTH_CODE_TTL_SECONDS=300
# 单个码最多试错次数
AUTH_CODE_MAX_ATTEMPTS=5
# 同号两次发码的最小间隔（秒）
AUTH_CODE_MIN_INTERVAL=60
AUTH_CODE_MAX_PER_HOUR=5
AUTH_CODE_MAX_PER_DAY=10

# 验证码哈希用的服务端密钥。留空 → 首次启动自动生成并存在库里（够用）
# AUTH_CODE_SECRET=

# 会话
AUTH_SESSION_DAYS=7
AUTH_LOGIN_MAX_PER_MINUTE=5
# 上了 HTTPS 再改成 1
AUTH_COOKIE_SECURE=0
# 公开无登录页模式：每位访客自动获得独立 HttpOnly Cookie；本地默认关闭。
# 公网部署设 AUTH_REQUIRE_LOGIN=1、AUTH_GUEST_MODE=1、AUTH_COOKIE_SECURE=1。
# GUEST_COOKIE_SECRET 必须是同一份、至少 32 字符的随机密钥，两个后端共用。
AUTH_GUEST_MODE=0
GUEST_COOKIE_SECRET=
# 公开体验的模型/检索调用额度（两个后端共享同一个持久化数据目录）。
GUEST_DAILY_LIMIT=20
GUEST_GLOBAL_DAILY_LIMIT=200
# 账号库位置，默认 data/auth.sqlite3
# AUTH_DB=

# 模拟发码的落盘位置，默认 data/sms-outbox.jsonl
# SMS_OUTBOX=

# 真实短信通道（要接才填；mock 模式下全部忽略）
# 注意：国内短信签名与模板需要主体报备，个人主体通常过不了审
# ---- 阿里云 ----
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_TEMPLATE_PARAM=code
# ---- 腾讯云 ----
# SMS_TENCENT_SECRET_ID=
# SMS_TENCENT_SECRET_KEY=
# SMS_TENCENT_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=

# config.yaml 当前实际使用的具名槽位（按账号服务能力填写）
PKULAW_URL_ADMIN_ENFORCE=
PKULAW_URL_AGGREGATE=
PKULAW_URL_ANTI_HALLUCINATION=
PKULAW_URL_CASE_KEYWORD=
PKULAW_URL_CASE_SEMANTIC=
PKULAW_URL_CASE_TRACE=
PKULAW_URL_HYPERLINK=
PKULAW_URL_PROSECUTION=
PKULAW_URL_STATUTE_EXACT=
PKULAW_URL_STATUTE_HISTORY=
PKULAW_URL_STATUTE_KEYWORD=
PKULAW_URL_STATUTE_SEMANTIC=
PKULAW_URL_STATUTE_TRACE=
