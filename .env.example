# ============================================================
# 法小智 · 本地配置模板（不含任何真实密钥，可以提交到仓库）
# 用法：复制本文件为 .env，填好标了【要填】的几行即可。
# .env 已被 .gitignore 排除，不会进仓库、不会进前端、不会进日志。
# 密钥只填在 .env 里 —— 不要贴在对话、截图或提交记录中。
# ============================================================

# ---- 模型（DeepSeek）----
# 留空也能启动：自动进入离线 stub 模式（用于自动化测试与断网降级）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-chat
MODEL_PROVIDER=auto          # auto | stub | deepseek

# ---- 北大法宝 MCP ----
# 有几个服务地址就填几个；不够可以接着加 PKULAW_MCP_URL_5=
# 地址里若已带密钥（?token=xxx），该地址本身即视为密钥，不要外发
PKULAW_MCP_URL_1=
PKULAW_MCP_URL_2=
PKULAW_MCP_URL_3=
PKULAW_MCP_URL_4=

# 所有地址共用一个鉴权 Key 时只填这一处；带不带 "Bearer " 前缀都行
PKULAW_MCP_TOKEN=

# ---- 本地服务 ----
APP_HOST=127.0.0.1
APP_PORT=8010

# config.yaml 当前实际使用的具名槽位（按账号服务能力填写）
PKULAW_URL_ADMIN_ENFORCE=
PKULAW_URL_AGGREGATE=
PKULAW_URL_ANTI_HALLUCINATION=
PKULAW_URL_CASE_KEYWORD=
PKULAW_URL_CASE_SEMANTIC=
PKULAW_URL_CASE_TRACE=
PKULAW_URL_HYPERLINK=
PKULAW_URL_PROSECUTION=
PKULAW_URL_STATUTE_EXACT=
PKULAW_URL_STATUTE_HISTORY=
PKULAW_URL_STATUTE_KEYWORD=
PKULAW_URL_STATUTE_SEMANTIC=
PKULAW_URL_STATUTE_TRACE=
