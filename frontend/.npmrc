audit=false
fund=false
update-notifier=false

# pnpm 11 起 `strictDepBuilds` **默认为 true**：只要有任何依赖带「未经审核的
# postinstall 脚本」，`pnpm install` 就以非零退出（ERR_PNPM_IGNORED_BUILDS）。
# 在容器/CI 里没人能交互地跑 `pnpm approve-builds`，于是整条构建直接挂掉 ——
# 2026-10-10 镜像构建就是这么失败的（报 Ignored build scripts: esbuild, sharp,
# unrs-resolver, workerd）。
#
# 这里降级为「警告 + 继续」。这四个包在 linux-x64 上都由各自的平台包
# （@esbuild/linux-x64、@img/sharp-linux-x64、@cloudflare/workerd-linux-64 等）
# 提供二进制，并不依赖 postinstall 现场编译，所以忽略它们是安全的。
# 真要让它们跑脚本，正确做法是在 pnpm-workspace.yaml 写 allowBuilds 白名单，
# 而不是打开 dangerouslyAllowAllBuilds。
strict-dep-builds=false
