# Copy to ../.env.production on the server. Keep that copy out of Git.
# Set both host fields to the public domain (without https://).
# If you do not own a domain yet, use <server-public-IP>.sslip.io for a trial.
SITE_HOST=law.example.com
ALLOWED_HOSTS=law.example.com

AUTH_REQUIRE_LOGIN=1
AUTH_GUEST_MODE=1
AUTH_COOKIE_SECURE=1
GUEST_COOKIE_SECRET=
# Low-cost public pilot. Raise only after checking actual model/MCP spend.
GUEST_DAILY_LIMIT=5
GUEST_GLOBAL_DAILY_LIMIT=30

MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-chat
MODEL_API_KEY=

# 短信验证码通道（2026-10-10：阿里云短信与号码认证服务两条通道都已实现）。
# ⚠️ 公开部署**不要**保留 SMS_PROVIDER=mock：mock 会把验证码明文写进服务端日志与
#    data/sms-outbox.jsonl，等于「拿到日志的人能登录成任意手机号」。
#    preflight_public.py 已有两条检查拦这个：sms_channel_is_real / sms_channel_configured。
# 填好后用 curl 打一次 /api/auth/code，确认返回里 channel=pnvs（或 aliyun）、mock=false。
# SMS_DRY_RUN=1 可先只构造请求不发送（日志不打验证码），用来核对签名与模板参数。
#
# ---- pnvs：号码认证服务（个人实名即可，免资质 / 免签名 / 免模板）----
# 代价：短信里的**发件人是阿里云赠送的签名**，不是自己的品牌名，且不可自定义。
# 签名名与模板编号从控制台「赠送签名配置 / 赠送模板配置」页抄，
# ⚠️ 两者必须配套使用（赠送签名 + 自定义模板是不允许的）。
# 只支持中国大陆手机号；核验免费，只收发送费。
SMS_PROVIDER=pnvs
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_PNVS_SIGN_NAME=
SMS_PNVS_TEMPLATE_CODE=
#
# ---- aliyun：短信服务（要自己的署名才走这条，需企业主体 + 签名实名报备）----
# 报备平均 5–7 个工作日、部分运营商 7–10 个，官方不承诺时效。
# 模板内容里**只写验证码**：阿里云模板禁用内容明确列着「法律维权」，
# 且法律调解类签名一旦被禁用不支持复开。
# SMS_PROVIDER=aliyun
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_TEMPLATE_PARAM=code
#
# SMS_DRY_RUN=0

# ⚠️ 别照这份模板手工抄 —— 用 `python3 deploy/render_env.py --site-host <域名>`
#    从本机 .env 自动生成。它会把你本机已验证可用的模型密钥、北大法宝 Token
#    以及**下面全部 14 个地址**一起搬过来，并对照 config.yaml 的 mcp.endpoints
#    逐个点名，少一个就拒绝生成。
#
#    手工抄这份模板最容易出的事故，就是只抄了 4 个、剩下 10 个静默消失：
#    线上一半检索工具不可用，但**不报错**，只是答案变差。
#
# 每个地址对应 config.yaml 里的一个具名槽位（mcp.endpoints 里逐个引用）。
# 不是每个都必须有；但这个文件里保留完整清单，是为了改的时候看得见全景。
PKULAW_MCP_TOKEN=
PKULAW_URL_STATUTE_SEMANTIC=
PKULAW_URL_STATUTE_KEYWORD=
PKULAW_URL_STATUTE_EXACT=
PKULAW_URL_STATUTE_TRACE=
PKULAW_URL_STATUTE_HISTORY=
PKULAW_URL_CASE_SEMANTIC=
PKULAW_URL_CASE_KEYWORD=
PKULAW_URL_CASE_TRACE=
PKULAW_URL_ANTI_HALLUCINATION=
PKULAW_URL_HYPERLINK=
PKULAW_URL_PROSECUTION=
PKULAW_URL_ADMIN_ENFORCE=
PKULAW_URL_AGGREGATE=

